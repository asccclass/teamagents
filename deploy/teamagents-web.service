[Unit]
Description=TeamAgents Web (Go)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/teamagents
Environment=PORT=3000
EnvironmentFile=/opt/teamagents/apps/web/.env.web
ExecStart=/opt/teamagents/bin/web
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=teamagents-web

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
