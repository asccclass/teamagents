# ============================================================
# TeamAgents 環境變數設定
# 複製此檔案為 .env 並填入真實值
# ============================================================

# --- Server ---
PORT=8080
APP_ENV=development           # development | production
APP_URL=http://localhost:3000 # 前端 URL（CORS 允許來源）
API_BASE=http://localhost:8080

# --- 資料庫 ---
# 格式: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=disable
DATABASE_URL=postgres://teamagents:password@localhost:5432/teamagents?sslmode=disable

# --- JWT ---
# 產生: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-me
JWT_EXPIRE_HOUR=168           # 7 天

# --- Email (Resend) ---
# 申請: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=noreply@teamagents.justdrink.com.tw

# --- 開發用 ---
# 設定後可用固定驗證碼登入（production 忽略此設定）
DEV_OTP_CODE=888888
